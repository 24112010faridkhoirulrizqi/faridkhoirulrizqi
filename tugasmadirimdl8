<style>
:root {
  --bg-main: #f3f8ff;
  --bg-gradient: linear-gradient(135deg, #e8f2ff 0%, #f3f8ff 100%);
  --card-bg: rgba(255, 255, 255, 0.9);
  --card-hover: #ffffff;
  --text-dark: #2c3e50;
  --text-muted: #6683a6;
  --primary: #78aee8;
  --primary-light: #a8cef5;
  --accent-soft: #d7e8fc;
  --accent-bg: #e8f2ff;
  --border-color: #d7e8fc;
  --shadow-sm: 0 4px 6px -1px rgba(120, 174, 232, 0.10);
  --shadow-md: 0 10px 25px -5px rgba(120, 174, 232, 0.22);
  --radius: 16px;
  box-sizing: border-box;
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg-main: #e4effc;
    --bg-gradient: linear-gradient(135deg, #e4effc 0%, #d8e8fb 100%);
    --card-bg: rgba(246, 250, 255, 0.94);
    --card-hover: #dcecff;
    --text-dark: #2c4d72;
    --text-muted: #6683a6;
    --primary: #78aee8;
    --primary-light: #a8cef5;
    --accent-soft: #c5dcf7;
    --accent-bg: #e8f2ff;
    --border-color: #d7e8fc;
    --shadow-md: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
  }
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 80px;
}

body {
  margin: 0;
  background: var(--bg-main);
  background-image: radial-gradient(#d7e8fc 0.75px, transparent 0.75px);
  background-size: 24px 24px;
  color: var(--text-dark);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  line-height: 1.6;
}

a {
  color: var(--primary);
  text-decoration: none;
  transition: all 0.25s ease;
}

header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(243, 248, 255, 0.88);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border-color);
}

nav {
  max-width: 1100px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  overflow-x: auto;
}

nav b {
  font-size: 18px;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: -0.5px;
  white-space: nowrap;
}

nav .nav-links {
  display: flex;
  gap: 8px;
}

nav a {
  color: var(--text-muted);
  padding: 8px 14px;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 500;
  white-space: nowrap;
}

nav a:hover {
  background: var(--accent-bg);
  color: var(--primary);
}

section {
  max-width: 1100px;
  margin: auto;
  padding: 60px 20px;
}

h2 {
  font-size: 32px;
  margin: 0 0 6px;
  color: var(--text-dark);
  letter-spacing: -0.5px;
  position: relative;
  display: inline-block;
}

h2::after {
  content: "";
  display: block;
  width: 40%;
  height: 4px;
  background: var(--primary-light);
  border-radius: 2px;
  margin-top: 4px;
}

.sub {
  color: var(--text-muted);
  margin: 0 0 32px;
  font-size: 15px;
}

.hero {
  padding-top: 80px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 130px;
  height: 130px;
  border-radius: 50%;
  margin-bottom: 20px;
  display: grid;
  place-items: center;
  font-size: 42px;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(135deg, var(--primary-light), var(--primary));
  box-shadow: 0 10px 20px rgba(120, 174, 232, 0.30);
  border: 4px solid #ffffff;
  overflow: hidden;
}

.avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  border-radius: 50%;
  display: block;
}

.hero h1 {
  font-size: clamp(32px, 5vw, 52px);
  margin: 0 0 12px;
  letter-spacing: -1px;
}

.hero p {
  color: var(--text-muted);
  max-width: 600px;
  font-size: 17px;
  margin: 0 auto 28px;
}

.btn-group {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--primary);
  color: #fff;
  border: 0;
  padding: 12px 24px;
  border-radius: 30px;
  font-size: 15px;
  cursor: pointer;
  font-weight: 600;
  box-shadow: 0 4px 12px rgba(120, 174, 232, 0.25);
  transition: all 0.25s ease;
}

.btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(120, 174, 232, 0.35);
  background: #659bd5;
}

.btn.o {
  background: var(--card-bg);
  color: var(--primary);
  border: 1px solid var(--primary-light);
  box-shadow: none;
}

.btn.o:hover {
  background: var(--accent-bg);
}

.grid {
  display: grid;
  gap: 20px;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
}

.card {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: var(--radius);
  padding: 24px;
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(8px);
  transition: all 0.3s ease;
}

.card:hover {
  background: var(--card-hover);
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
  border-color: var(--primary-light);
}

.card h3 {
  margin: 0 0 8px;
  font-size: 18px;
  color: var(--text-dark);
}

.card p, .card li {
  color: var(--text-muted);
  font-size: 14.5px;
  margin: 0;
}

.card ul {
  margin: 0;
  padding-left: 20px;
}

.tag {
  display: inline-block;
  font-size: 12px;
  font-weight: 600;
  background: var(--accent-bg);
  color: var(--primary);
  padding: 4px 12px;
  border-radius: 20px;
  margin-bottom: 12px;
}

.ov a.card {
  display: block;
  color: inherit;
}

dl {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 12px 16px;
  margin: 0;
}

dt {
  color: var(--text-muted);
  font-weight: 500;
}

dd {
  margin: 0;
  font-weight: 600;
  color: var(--text-dark);
  word-break: break-word;
}

.tl {
  border-left: 3px solid var(--accent-soft);
  margin-left: 10px;
  padding-left: 24px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.tl div {
  position: relative;
}

.tl div::before {
  content: "";
  position: absolute;
  left: -31px;
  top: 4px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--primary);
  border: 3px solid var(--bg-main);
  box-shadow: 0 0 0 2px var(--primary-light);
}

.tl b {
  display: block;
  font-size: 16px;
  color: var(--text-dark);
}

.tl span {
  color: var(--text-muted);
  font-size: 14px;
}

form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

label {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-dark);
  margin-bottom: 4px;
  display: block;
}

input, textarea {
  width: 100%;
  padding: 12px 16px;
  border-radius: 10px;
  border: 1px solid var(--border-color);
  background: var(--card-bg);
  color: var(--text-dark);
  font: inherit;
  transition: all 0.25s ease;
}

input:focus, textarea:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(168, 206, 245, 0.35);
  background: var(--card-hover);
}

.two {
  display: grid;
  gap: 24px;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
}

footer {
  background: var(--card-bg);
  border-top: 1px solid var(--border-color);
  color: var(--text-muted);
  font-size: 14px;
  margin-top: 40px;
  backdrop-filter: blur(10px);
}

.ft {
  max-width: 1100px;
  margin: auto;
  padding: 48px 20px 24px;
  display: grid;
  gap: 32px;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
}

.ft h4 {
  margin: 0 0 12px;
  color: var(--text-dark);
  font-size: 16px;
}

.ft a {
  display: block;
  color: var(--text-muted);
  padding: 4px 0;
}

.ft a:hover {
  color: var(--primary);
}

.ft p {
